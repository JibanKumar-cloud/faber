{
  "name": "faberwright",
  "version": "0.4.4",
  "description": "Faber: an agentic AI coding assistant for your terminal — streams, edits with diff approval, runs your tests, and remembers your project across sessions.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "faber": "dist/index.js",
    "fb": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc && node --test dist-test/test/*.test.js",
    "prepublishOnly": "npm test && npm run build",
    "dev": "tsc -p tsconfig.build.json --watch",
    "postbuild": "chmod +x dist/index.js"
  },
  "dependencies": {
    "diff": "^7.0.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "ai",
    "cli",
    "coding-assistant",
    "agent",
    "anthropic",
    "claude",
    "openai",
    "ollama",
    "code-graph",
    "developer-tools",
    "terminal",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JibanKumar-cloud/faber.git"
  },
  "homepage": "https://github.com/JibanKumar-cloud/faber#readme",
  "bugs": {
    "url": "https://github.com/JibanKumar-cloud/faber/issues"
  }
}
